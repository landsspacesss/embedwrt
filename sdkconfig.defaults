# --- NAT routing: required for the AP<->STA forwarder ---
# Without these two the build fails: ip_napt_enable/esp_netif_napt_enable is a no-op.
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# --- Board: ESP32-S3 N16R8 (16 MB flash) ---
#
# The target is pinned here, not left to `idf.py set-target`, because otherwise
# a fresh checkout has no target and IDF silently defaults to esp32: the build
# succeeds and produces an image for the wrong chip. That is invisible on a
# machine that ran set-target once (the choice is cached in sdkconfig, which is
# gitignored) and only shows up in CI or on someone else's clone.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- 4 MB app partition (see partitions.csv) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- DHCP: run the vendored copy (main/dhcps) so static leases become possible.
# --- The vendored copy and IDF's server define the same symbols, so IDF's must
# --- be off; flipping these two back is the rollback. ---
CONFIG_LWIP_DHCPS=n
CONFIG_USE_OWN_DHCPS=y

# --- OTA: two app slots (ota_0/ota_1) with boot-time rollback. A freshly OTA'd
# --- image boots as PENDING_VERIFY; if it crashes before app_main reaches
# --- esp_ota_mark_app_valid_cancel_rollback() the bootloader reverts to the
# --- other slot. This is the only thing that recovers a build which is a valid
# --- image but panics at boot. ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- mbedTLS: wall clock + root CA bundle, both needed by DNS-over-HTTPS ---
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# --- Cross-signed chains. Off by default, and that default breaks GitHub's
# --- release asset host: release-assets.githubusercontent.com serves a chain
# --- whose root (ISRG Root YR) is cross-signed by ISRG Root X1, which the
# --- bundle does not contain as a leaf. Without this, TLS verification cannot
# --- complete that path and every asset download fails as "cannot connect"
# --- while api.github.com (a DigiCert chain) works, which makes the fault look
# --- like a network problem rather than a trust-store one. Costs ~700 bytes. ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# --- SNTP: 2 slots so a dead NTP host does not block time sync ---
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# --- Default is 6, so a page load's worth of simultaneous lookups overflows the
# --- socket and lwIP silently drops the excess before the relay ever sees it. ---
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# --- Keep the TLS session to the DoH resolver alive between queries ---
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y

# --- TLS handshake cost on this chip is CPU-bound; 240 MHz is free headroom ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- ESP-IDF ships -Og (debug-friendly). A full TLS handshake here is software
# --- big-integer ECC, which -O2 speeds up materially. ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Block-ACK windows. Kconfig documents 16 as the value needed for good
# --- throughput ("the default and minimum value should be 16"); it stays at 6
# --- unless WiFi/LWIP buffers are moved to PSRAM. We set it outright rather
# --- than relocating those buffers, which would add PSRAM latency to the
# --- forwarding path. ---
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_TX_BA_WIN=16

# --- Board has 8 MB octal PSRAM. Several concurrent TLS sessions to the DoH
# --- resolver are what keeps lookups parallel, and they do not fit in internal
# --- RAM alone. ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Send allocations over 4 KB to PSRAM, so TLS record buffers land there too.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# --- Global socket pool. The IDF default of 10 is shared by everything: the web
# --- server wants up to 7 (its own max_open_sockets), while the DNS relay
# --- listener, the DoH TLS workers, the DoT client, DHCP and SNTP take several
# --- more. Measured effect of leaving it at 10: a fourth concurrent HTTP
# --- connection was already refused, so a browser holding a few keep-alive
# --- sockets could make the panel unreachable entirely. Raise it so the web
# --- server can actually have the sockets it asks for.
CONFIG_LWIP_MAX_SOCKETS=24
